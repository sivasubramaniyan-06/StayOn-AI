# StayOn AI Environment Configuration Example
# Copy to .env and configure as needed. NEVER commit real API keys.

# AI Provider Selection: 'bedrock' (default) or 'gemini'
AI_PROVIDER=bedrock

# Amazon Bedrock Settings
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
AWS_REGION=ap-south-1
AWS_PROFILE=stayon

# Google Gemini Settings
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
