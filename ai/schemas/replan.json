{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplanGeneration",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "taskTitle": {
            "type": "string"
          },
          "currentDate": {
            "type": ["string", "null"]
          },
          "proposedDate": {
            "type": "string"
          },
          "changeType": {
            "type": "string"
          },
          "fromDate": {
            "type": ["string", "null"]
          },
          "toDate": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "proposedDate"
        ],
        "additionalProperties": false
      }
    },
    "requiresUserConfirmation": {
      "type": "boolean",
      "enum": [true]
    }
  },
  "required": [
    "planId",
    "summary",
    "changes",
    "requiresUserConfirmation"
  ],
  "additionalProperties": false
}
