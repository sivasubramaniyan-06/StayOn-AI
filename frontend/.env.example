# STAYON AI Frontend Environment Configuration

# API Gateway Base URL
VITE_API_BASE_URL=https://api.stayon.ai/v1

# AWS Cognito Configuration (Optional for production auth)
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid12345
VITE_COGNITO_REGION=us-east-1

# Enable dev mock data fallback when backend is unreachable
VITE_ENABLE_MOCK_FALLBACK=true
